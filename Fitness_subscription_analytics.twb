      <aliases enabled='yes' />
      <column caption='Acquisition Channel' datatype='string' name='[Acquisition_Channel]' role='dimension' type='nominal' />
      <column caption='Cohort Month' datatype='date' default-format='*mmmm yyyy' name='[Calculation_1880230916055041]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Customer_ID] : MIN([Transaction_Date])}' />
      </column>
      <column caption='Cohort Age (Months)' datatype='integer' name='[Calculation_1880230916939778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_1880230916055041],[Transaction_Date])' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_1880230922063875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer_ID])' />
      </column>
      <column caption='Start of Month' datatype='date' datatype-customized='true' default-format='*mmmm yyyy' name='[Calculation_1880230927413252]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[Transaction_Date]))' />
      </column>
      <column aggregation='Sum' caption='Cohort Year' datatype='integer' name='[Calculation_1880230939025413]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR({FIXED [Customer_ID] : MIN([Transaction_Date])})' />
      </column>
      <column aggregation='Sum' caption='Customer Months Since Sign Up' datatype='integer' name='[Calculation_1880230940975110]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, {FIXED[Customer_ID] : MIN([Transaction_Date])}, [Transaction_Date])' />
      </column>
      <column caption='Total CAC' datatype='real' name='[Calculation_1880230945681415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([CAC]))' />
      </column>
      <column caption='Month Label' datatype='string' name='[Calculation_1880230953164809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Month &quot; + STR([Calculation_1880230940975110])' />
      </column>
      <column caption='Cumulative Total' datatype='integer' name='[Calculation_1880230967283730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
